{
  "name": "hpa-school-gestion",
  "image": "mcr.microsoft.com/devcontainers/php:8.3",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "remoteEnv": {
    "XDEBUG_MODE": "off"
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Application Laravel",
      "onAutoForward": "openPreview"
    }
  },

  "postCreateCommand": "bash .devcontainer/installation.sh",
  "postStartCommand": "bash .devcontainer/demarrage.sh"
}
